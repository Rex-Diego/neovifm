{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neovifm.dev/protocol/neovifm-core-v0.schema.json",
  "title": "NeoVifm Core Protocol v0",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "version", "type", "sequence", "payload"],
      "properties": {
        "protocol": { "const": "neovifm-core" },
        "version": { "const": 0 },
        "type": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "payload": { "type": "object" }
      }
    },
    "decimalString": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "unsignedDecimalString": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "hexBytes": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "hello": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "hello" },
            "payload": {
              "type": "object",
              "required": ["implementation", "capabilities"],
              "properties": {
                "implementation": { "type": "string", "minLength": 1, "maxLength": 16384 },
                "capabilities": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "name_display",
        "name_bytes_hex",
        "path_display",
        "path_bytes_hex",
        "kind",
        "size_bytes",
        "mtime_unix_ms",
        "selected",
        "hidden"
      ],
      "properties": {
        "name_display": { "type": "string", "maxLength": 16384 },
        "name_bytes_hex": { "$ref": "#/$defs/hexBytes", "maxLength": 32768 },
        "path_display": { "type": "string", "maxLength": 16384 },
        "path_bytes_hex": { "$ref": "#/$defs/hexBytes", "maxLength": 32768 },
        "kind": {
          "enum": [
            "directory",
            "file",
            "symlink",
            "executable",
            "fifo",
            "socket",
            "char-device",
            "block-device",
            "unknown"
          ]
        },
        "size_bytes": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
        "mtime_unix_ms": { "$ref": "#/$defs/decimalString", "maxLength": 32 },
        "device": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
        "inode": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
        "ctime_unix_ns": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
        "mode_octal": { "type": "string", "pattern": "^[0-7]+$", "maxLength": 32 },
        "attributes_hex": { "type": "string", "pattern": "^[0-9a-f]+$", "maxLength": 32768 },
        "selected": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "stat_error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "maxLength": 16384 }
          }
        }
      }
    },
    "snapshot": {
      "$comment": "cursor is -1 exactly when entry_count is 0; otherwise 0 <= cursor < entry_count",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "snapshot" },
            "payload": {
              "type": "object",
              "required": [
                "cwd_display",
                "cwd_bytes_hex",
                "generated_at_unix_ms",
                "cursor",
                "entry_count",
                "entries"
              ],
              "properties": {
                "cwd_display": { "type": "string", "maxLength": 16384 },
                "cwd_bytes_hex": { "$ref": "#/$defs/hexBytes", "maxLength": 32768 },
                "generated_at_unix_ms": { "$ref": "#/$defs/decimalString", "maxLength": 32 },
                "snapshot_revision": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
                "cwd_device": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
                "cwd_inode": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
                "cwd_ctime_unix_ns": { "$ref": "#/$defs/unsignedDecimalString", "maxLength": 32 },
                "cursor": { "type": "integer", "minimum": -1 },
                "entry_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
                "selection_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
                "filtered_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
                "sort_key": { "enum": ["name", "extension", "size", "ctime", "mtime", "mode", "type", "other"] },
                "sort_descending": { "type": "boolean" },
                "filter_active": { "type": "boolean" },
                "entries": {
                  "type": "array",
                  "maxItems": 4096,
                  "items": { "$ref": "#/$defs/entry" }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "entry_count": { "const": 0 } } },
                  "then": { "properties": { "cursor": { "const": -1 } } }
                },
                {
                  "if": { "properties": { "entry_count": { "minimum": 1 } } },
                  "then": { "properties": { "cursor": { "minimum": 0 } } }
                }
              ]
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "error" },
            "payload": {
              "type": "object",
              "required": ["code", "message", "retryable"],
              "properties": {
                "code": { "type": "string", "minLength": 1, "maxLength": 128 },
                "message": { "type": "string", "maxLength": 16384 },
                "retryable": { "type": "boolean" },
                "path_display": { "type": "string", "maxLength": 16384 },
                "path_bytes_hex": { "$ref": "#/$defs/hexBytes", "maxLength": 32768 },
                "os_error": { "type": "integer" }
              }
            }
          }
        }
      ]
    }
  }
}

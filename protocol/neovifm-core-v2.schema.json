{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neovifm.dev/protocol/neovifm-core-v2.schema.json",
  "title": "NeoVifm Core Session Protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/workspaceSnapshot" },
    { "$ref": "#/$defs/commandError" },
    { "$ref": "#/$defs/command" }
  ],
  "$defs": {
    "base": { "type": "object", "required": ["protocol", "version", "type", "sequence", "payload"], "properties": { "protocol": { "const": "neovifm-core" }, "version": { "const": 2 }, "type": { "type": "string" }, "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "payload": { "type": "object" } } },
    "hello": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "neovifm-core-v1.schema.json#/$defs/helloPayload" } } }] },
    "workspaceSnapshot": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "workspace-snapshot" }, "payload": { "type": "object", "required": ["command_sequence", "trigger", "active_pane", "left", "right"], "properties": { "command_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "trigger": { "enum": ["initial", "command", "watch"] }, "active_pane": { "enum": ["left", "right"] }, "left": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" }, "right": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" } }, "$comment": "left.entry_count + right.entry_count must not exceed 4096" } } }] },
    "commandError": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "command-error" }, "payload": { "type": "object", "required": ["command_sequence", "code", "message", "retryable"], "properties": { "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "maxLength": 16384 }, "retryable": { "type": "boolean" } } } } }] },
    "command": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "command" }, "payload": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["focus", "move", "enter", "parent", "toggle-selection", "refresh"] }, "pane": { "enum": ["left", "right"] }, "delta": { "enum": [-1, 1] } } } } }] }
  }
}

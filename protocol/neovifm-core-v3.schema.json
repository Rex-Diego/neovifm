{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neovifm.dev/protocol/neovifm-core-v3.schema.json",
  "title": "NeoVifm Core Preview Session Protocol v3",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/workspaceSnapshot" },
    { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/preview" },
    { "$ref": "#/$defs/actionTask" },
    { "$ref": "#/$defs/commandError" },
    { "$ref": "#/$defs/command" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "version", "type", "sequence", "payload"],
      "properties": {
        "protocol": { "const": "neovifm-core" },
        "version": { "const": 3 },
        "type": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "payload": { "type": "object" }
      }
    },
    "hello": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "neovifm-core-v1.schema.json#/$defs/helloPayload" } } }
      ]
    },
    "workspaceSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "workspace-snapshot" },
            "payload": {
              "type": "object",
              "required": ["command_sequence", "trigger", "active_pane", "left", "right"],
              "properties": {
                "command_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "trigger": { "enum": ["initial", "command", "watch", "action"] },
                "active_pane": { "enum": ["left", "right"] },
                "left": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" },
                "right": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" }
              }
            }
          }
        }
      ]
    },
    "taskPayload": {
      "type": "object",
      "required": ["task_id", "generation", "pane", "kind", "state", "cwd_bytes_hex", "path_bytes_hex"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "generation": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "pane": { "enum": ["left", "right"] },
        "kind": { "enum": ["text", "directory"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os_error": { "type": "integer" }
      }
    },
    "task": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "task" }, "payload": { "$ref": "#/$defs/taskPayload" } } }
      ]
    },
    "preview": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "preview" },
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/taskPayload" },
                {
                  "required": ["truncated"],
                  "properties": {
                    "truncated": { "type": "boolean" },
                    "content": { "type": "string", "maxLength": 65536 }
                  },
                  "$comment": "state must be done, failed, or cancelled; content is required for done"
                }
              ]
            }
          }
        }
      ]
    },
    "actionTaskPayload": {
      "type": "object",
      "required": ["task_id", "command_sequence", "pane", "action", "state", "completed_count", "total_count", "partial"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pane": { "enum": ["left", "right"] },
        "action": { "enum": ["copy", "move", "mkdir", "delete"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "completed_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "total_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "failed_index": { "type": "integer", "minimum": 0, "maximum": 63 },
        "partial": { "type": "boolean" },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os_error": { "type": "integer" }
      }
    },
    "actionTask": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "action-task" }, "payload": { "$ref": "#/$defs/actionTaskPayload" } } }
      ]
    },
    "commandError": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "command-error" },
            "payload": {
              "type": "object",
              "required": ["command_sequence", "code", "message", "retryable"],
              "properties": {
                "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "code": { "type": "string", "minLength": 1, "maxLength": 128 },
                "message": { "type": "string", "maxLength": 16384 },
                "retryable": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "actionTarget": {
      "type": "object",
      "required": ["path_bytes_hex", "device", "inode", "ctime_unix_ns", "kind"],
      "properties": {
        "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "kind": { "enum": ["directory", "file", "symlink", "executable", "fifo", "socket", "char-device", "block-device", "unknown"] }
      }
    },
    "actionTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionTarget" }
    },
    "sourceIdentity": {
      "properties": {
        "pane": { "enum": ["left", "right"] },
        "cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "snapshot_revision": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" }
      }
    },
    "commandPayload": {
      "oneOf": [
        { "type": "object", "required": ["action", "pane"], "properties": { "action": { "const": "focus" }, "pane": { "enum": ["left", "right"] } } },
        { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["focus-next", "enter", "parent", "toggle-selection", "refresh"] } } },
        { "type": "object", "required": ["action", "delta"], "properties": { "action": { "enum": ["move", "sort-cycle"] }, "delta": { "enum": [-1, 1] } } },
        { "type": "object", "required": ["action", "target"], "properties": { "action": { "const": "move-to" }, "target": { "enum": ["first", "last"] } } },
        { "type": "object", "required": ["action", "pane", "key"], "properties": { "action": { "const": "sort-by" }, "pane": { "enum": ["left", "right"] }, "key": { "enum": ["name", "extension", "size", "mtime", "mode", "type", "other"] } } },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "destination_cwd_bytes_hex", "destination_snapshot_revision", "destination_cwd_device", "destination_cwd_inode", "destination_cwd_ctime_unix_ns", "targets"],
              "properties": {
                "action": { "enum": ["copy", "move-files"] },
                "destination_cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
                "destination_snapshot_revision": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "targets": { "$ref": "#/$defs/actionTargets" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "targets"],
              "properties": { "action": { "const": "delete" }, "targets": { "$ref": "#/$defs/actionTargets" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "name"],
              "properties": { "action": { "const": "mkdir" }, "name": { "type": "string", "minLength": 1, "maxLength": 255 } }
            }
          ]
        }
      ]
    },
    "command": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/commandPayload" } } }
      ]
    }
  }
}

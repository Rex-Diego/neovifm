{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neovifm.dev/protocol/neovifm-core-v3.schema.json",
  "title": "NeoVifm Core Preview Session Protocol v3",
  "oneOf": [{ "$ref": "#/$defs/hello" }, { "$ref": "#/$defs/workspaceSnapshot" }, { "$ref": "#/$defs/task" }, { "$ref": "#/$defs/preview" }, { "$ref": "#/$defs/commandError" }, { "$ref": "#/$defs/command" }],
  "$defs": {
    "base": { "type": "object", "required": ["protocol", "version", "type", "sequence", "payload"], "properties": { "protocol": { "const": "neovifm-core" }, "version": { "const": 3 }, "type": { "type": "string" }, "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "payload": { "type": "object" } } },
    "hello": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "neovifm-core-v1.schema.json#/$defs/helloPayload" } } }] },
    "workspaceSnapshot": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "workspace-snapshot" }, "payload": { "type": "object", "required": ["command_sequence", "trigger", "active_pane", "left", "right"], "properties": { "command_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "trigger": { "enum": ["initial", "command", "watch"] }, "active_pane": { "enum": ["left", "right"] }, "left": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" }, "right": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" } } } } }] },
    "taskPayload": { "type": "object", "required": ["task_id", "generation", "pane", "kind", "state", "cwd_bytes_hex", "path_bytes_hex"], "properties": { "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 }, "generation": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 }, "pane": { "enum": ["left", "right"] }, "kind": { "enum": ["text", "directory"] }, "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] }, "cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" }, "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" }, "error_code": { "type": "string", "minLength": 1, "maxLength": 128 }, "os_error": { "type": "integer" } } },
    "task": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "task" }, "payload": { "$ref": "#/$defs/taskPayload" } } }] },
    "preview": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "preview" }, "payload": { "allOf": [{ "$ref": "#/$defs/taskPayload" }, { "required": ["truncated"], "properties": { "truncated": { "type": "boolean" }, "content": { "type": "string", "maxLength": 65536 } }, "$comment": "state must be done, failed, or cancelled; content is required for done" }] } } }] },
    "commandError": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "command-error" }, "payload": { "type": "object", "required": ["command_sequence", "code", "message", "retryable"], "properties": { "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "maxLength": 16384 }, "retryable": { "type": "boolean" } } } } }] },
    "command": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "command" }, "payload": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["focus", "focus-next", "move", "move-to", "enter", "parent", "toggle-selection", "refresh"] }, "pane": { "enum": ["left", "right"] }, "delta": { "enum": [-1, 1] }, "target": { "enum": ["first", "last"] } } } } }] }
  }
}
